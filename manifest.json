{
  "manifest_version": 3,
  "name": "Outlook Web & Gemini Enterprise Right-to-Left",
  "version": "1.1.0",
  "description": "Applies Right-to-Left (RTL) text direction in the Outlook Web email composer and Gemini Enterprise conversations.",
  "author": "Assaf",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*",
        "https://outlook.live.com/mail/*",
        "https://outlook.cloud.microsoft.com/mail/*",
        "https://outlook.cloud.microsoft/mail/*"
      ],
      "js": ["common.js", "outlook.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vertexaisearch.cloud.google/*",
        "https://vertexaisearch.cloud.google.com/*"
      ],
      "js": ["common.js", "gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "homepage_url": "https://github.com/assafshp/Outlook-Web-Right-to-Left-Chrome-Extension",
  "minimum_chrome_version": "88"
}
